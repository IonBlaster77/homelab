{
  // Type-check only. Node runs the .ts files directly (type stripping), so
  // nothing is compiled: code must use erasable syntax only (no enums,
  // namespaces or parameter properties) and import with .ts extensions.
  "compilerOptions": {
    "target": "es2024",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "test", "drizzle.config.ts"]
}
