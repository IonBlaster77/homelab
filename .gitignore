# Cluster credentials - never in repo
talosconfig
kubeconfig
kubeconfig*.yaml

# Binaries and installers
argocd
argocd-linux-amd64
*.exe
*.zst
*.zip

# Windows NTFS alternate data streams (created when files are downloaded on Windows).
# WSL can't store the ':' in a Linux filename, so it maps it to U+F03A — the
# colon-form glob below won't match those, hence the colon-free pattern too.
*:Zone.Identifier
*Zone.Identifier

# Credential files
*PAT*
*token*
*.key
*.private.yaml
*.dec.yaml
