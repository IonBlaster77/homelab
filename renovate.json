{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabled": true,
  "timezone": "Australia/Adelaide",
  "ignorePaths": [
    "**/node_modules/**",
    "talos/**",
    "bootstrap/**",
    "kubernetes/**/chart/charts/**"
  ],
  "prConcurrentLimit": 15,
  "kubernetes": {
    "managerFilePatterns": ["/^kubernetes/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/^kubernetes/.+/values\\.ya?ml$/"]
  },
  "argocd": {
    "managerFilePatterns": ["/^kubernetes/.+/app\\.yaml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["kubernetes", "helm-values", "argocd"],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "matchManagers": ["kubernetes"],
      "matchPackageNames": ["ollama/ollama"],
      "enabled": false
    },
    {
      "description": "cilium and argocd are manual-sync: merging does nothing until someone syncs them, and a full sync is the risky part.",
      "matchFileNames": [
        "kubernetes/platform/networking/cilium/**",
        "kubernetes/platform/system/argocd/**"
      ],
      "addLabels": ["manual-sync"],
      "prBodyNotes": [
        "This app is manual-sync. After merging, review `argocd app diff` and sync deliberately; never full-sync cilium or argocd without checking the diff."
      ]
    }
  ],
  "labels": ["renovate"],
  "assignees": ["IonBlaster77"]
}
