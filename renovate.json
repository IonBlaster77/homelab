{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabled": false,
  "timezone": "Australia/Adelaide",
  "ignorePaths": [
    "**/node_modules/**",
    "talos/**",
    "bootstrap/**",
    "gitops/homepage-chart/charts/**"
  ],
  "prConcurrentLimit": 15,
  "kubernetes": {
    "managerFilePatterns": ["/clusters/homelab/.+\\.ya?ml$/"]
  },
  "helm-values": {
    "managerFilePatterns": ["/gitops/.+values\\.ya?ml$/"]
  },
  "packageRules": [
    {
      "matchManagers": ["kubernetes", "helm-values"],
      "commitMessageTopic": "{{depName}}"
    },
    {
      "matchManagers": ["kubernetes"],
      "matchPackageNames": ["ollama/ollama"],
      "enabled": false
    }
  ],
  "labels": ["renovate"],
  "assignees": ["IonBlaster77"]
}
